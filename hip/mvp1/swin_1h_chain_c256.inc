__device__ inline unsigned int sw_f32_as_u32(float f) {
    union {
        float ff;
        unsigned int u;
    } c;
    c.ff = f;
    return c.u;
}

__device__ inline unsigned short sw_f32_to_f16_bits(float f) {
    unsigned int u = sw_f32_as_u32(f);
    unsigned int s = (u >> 16) & 0x8000u;
    unsigned int E = (u >> 23) & 0xFFu;
    unsigned int M = u & 0x7FFFFFu;
    if (E == 0xFFu) {
        if (M == 0) return (unsigned short)(s | 0x7C00u);  // inf
        unsigned int pay = (M >> 13) | 0x0200u;  // preserve payload, quiet
        return (unsigned short)(s | 0x7C00u | pay);
    }
    int e = (int)E - 112;  // f16-biased exponent
    if (e >= 31) return (unsigned short)(s | 0x7C00u);  // overflow -> inf
    if (e <= 0) {  // subnormal result (or zero)
        if (e < -10) return (unsigned short)s;
        unsigned int S = M | 0x800000u;  // 24-bit significand
        int shift = 14 - e;  // 14..24
        unsigned int half = 1u << (shift - 1);
        unsigned int mask = (shift >= 32) ? 0xFFFFFFFFu : ((1u << shift) - 1u);
        unsigned int rem = S & mask;
        unsigned int res = S >> shift;  // candidate 10-bit mantissa
        if (rem > half || (rem == half && (res & 1u))) res++;
        if (res >= 1024u) return (unsigned short)(s | 0x0400u);  // -> min normal
        return (unsigned short)(s | res);
    }
    {  // normal result: drop 13 bits, RN-even
        unsigned int rem = M & 0x1FFFu;
        unsigned int res = M >> 13;
        if (rem > 0x1000u || (rem == 0x1000u && (res & 1u))) {
            res++;
            if (res >= 1024u) {
                res = 0;
                e++;
                if (e >= 31) return (unsigned short)(s | 0x7C00u);
            }
        }
        return (unsigned short)(s | ((unsigned int)e << 10) | res);
    }
}

__device__ inline float sw_f16_to_f32(unsigned short u) {
    unsigned int s = (unsigned int)(u & 0x8000u) << 16;
    unsigned int e = ((unsigned int)u >> 10) & 0x1Fu;
    unsigned int m = (unsigned int)u & 0x3FFu;
    unsigned int out;
    if (e == 0x1Fu) {
        out = s | 0x7F800000u | (m << 13);  // inf / nan (payload kept)
    } else if (e == 0u) {
        if (m == 0) {
            out = s;
        } else {  // subnormal -> normalize
            e = 1;
            while ((m & 0x400u) == 0) {
                m <<= 1;
                e--;
            }
            m &= 0x3FFu;
            out = s | ((unsigned int)(e + 112) << 23) | (m << 13);
        }
    } else {
        out = s | ((unsigned int)(e + 112) << 23) | (m << 13);
    }
    float f;
    memcpy(&f, &out, 4);
    return f;
}

__device__ inline unsigned char sw_h2e4m3(unsigned short u16) {
    unsigned char sign = (unsigned char)((u16 >> 15) & 1);
    unsigned short abs_u16 = u16 & 0x7FFFu;
    if (abs_u16 > 0x7C00u) return (unsigned char)((sign << 7) | 0x7F);
    if (abs_u16 >= 0x5EC0u) return (unsigned char)((sign << 7) | 0x7E);
    if (abs_u16 <= 0x1400u) return (unsigned char)((sign << 7) | 0x00);
    unsigned short exp = abs_u16 >> 10;
    unsigned short mant = abs_u16 & 0x3FFu;
    if (exp < 9) {
        unsigned int sig = 1024u + mant;
        int shift = 16 - (int)exp;
        unsigned int half_lsb = 1u << (shift - 1);
        unsigned int mm = (shift >= 32) ? 0xFFFFFFFFu : ((1u << shift) - 1u);
        unsigned int rem = sig & mm;
        unsigned int res = sig >> shift;
        if (rem > half_lsb || (rem == half_lsb && (res & 1u))) res++;
        return (unsigned char)((sign << 7) | (unsigned char)res);
    }
    unsigned char e_8 = (unsigned char)(exp - 8);
    unsigned char m_8 = (unsigned char)(mant >> 7);
    unsigned short rem = mant & 0x7Fu;
    if (rem > 64 || (rem == 64 && (m_8 & 1))) {
        m_8++;
        if (m_8 == 8) {
            m_8 = 0;
            e_8++;
        }
    }
    return (unsigned char)((sign << 7) | (e_8 << 3) | m_8);
}

__device__ inline float sw_e4m3_decode(unsigned char b) {
    if (b == 0x7Fu || b == 0xFFu) return 0.0f;
    unsigned int s = (b >> 7) & 1u;
    unsigned int e = (b >> 3) & 0xFu;
    unsigned int m = b & 7u;
    float v;
    if (e == 0)
        v = (float)m / 512.0f;
    else {
        // (1 + m/8) * 2^(e-7); exact in f32 for all codes
        int e2 = (int)e - 7;
        v = (float)(8u + m) / 8.0f;
        v = (e2 >)HIPSWINCHAIN"
    R"HIPSWINCHAIN(= 0) ? v * (float)(1u << e2) : v / (float)(1u << (-e2));
    }
    return s ? -v : v;
}

