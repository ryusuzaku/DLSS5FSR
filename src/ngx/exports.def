; DLSS-NR forwarder interface (see Dagherbou/OptiScaler_DLSSNR). OptiScaler's
; DlssNrFeature loads nvngx.dll_dlssnr.dll and requires these in addition to
; the four NGX D3D12 entry points above; without them it reports "the
; forwarder is missing its exports" and never calls us.
    dlssnr_call_set_float_slot
    dlssnr_call_probe_float
    dlssnr_call_last_init DATA
    dlssnr_call_last_create DATA
    dlssnr_call_create
    dlssnr_call_evaluate
    dlssnr_call_set_extras
    dlssnr_call_release
